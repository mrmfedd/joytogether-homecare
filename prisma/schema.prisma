// JoyTogether Home Care — business admin CRM (not clinical/EHR data)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CARE_COORDINATOR
  CONTENT_EDITOR
  RECRUITER
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  QUALIFIED
  CONVERTED
  NOT_INTERESTED
  CLOSED
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicantStatus {
  NEW
  UNDER_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PUBLISH
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  emailVerified  DateTime?
  name           String?
  passwordHash   String?
  role           UserRole  @default(VIEWER)
  active         Boolean   @default(true)
  mfaEnabled     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  accounts            Account[]
  sessions            Session[]
  assignedLeads       Lead[]            @relation("LeadAssignee")
  leadActivities      LeadActivity[]
  leadAssignments     LeadAssignment[]
  consultations       Consultation[]    @relation("ConsultationAssignee")
  followUpTasks       FollowUpTask[]    @relation("TaskAssignee")
  contentRevisions    ContentRevision[]
  auditLogs           AuditLog[]
  invitationsCreated  AdminInvitation[] @relation("InviteCreator")
  invitationsAccepted AdminInvitation[] @relation("InviteAccepted")
  jobReviews          JobApplication[]  @relation("ApplicationReviewer")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AdminInvitation {
  id          String    @id @default(uuid())
  email       String
  role        UserRole
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String?
  acceptedById String?
  createdAt   DateTime  @default(now())

  createdBy  User? @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedBy User? @relation("InviteAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
}

model Lead {
  id                 String     @id @default(uuid())
  fullName           String
  email              String
  phone              String
  serviceInterest    String
  location           String?
  preferredContact   String?
  preferredTime      String?
  source             String
  status             LeadStatus @default(NEW)
  nonClinicalNotes   String?    @db.Text
  consentAt          DateTime
  consentTextVersion String
  assignedToId       String?
  idempotencyKey     String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  assignedTo     User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  assignments    LeadAssignment[]
  consultations  Consultation[]
  followUpTasks  FollowUpTask[]
  consentRecords ConsentRecord[]

  @@index([status])
  @@index([serviceInterest])
  @@index([createdAt])
  @@index([email])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  type      String
  summary   String   @db.Text
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LeadAssignment {
  id         String   @id @default(uuid())
  leadId     String
  userId     String
  assignedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Consultation {
  id              String             @id @default(uuid())
  leadId          String
  status          ConsultationStatus @default(REQUESTED)
  scheduledAt     DateTime?
  assignedToId    String?
  internalNotes   String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User?           @relation("ConsultationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUps  FollowUpTask[]

  @@index([status])
  @@index([scheduledAt])
}

model FollowUpTask {
  id             String         @id @default(uuid())
  leadId         String?
  consultationId String?
  title          String
  dueAt          DateTime?
  status         FollowUpStatus @default(OPEN)
  assignedToId   String?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  assignedTo   User?         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
}

model Service {
  id              String            @id @default(uuid())
  slug            String            @unique
  name            String
  category        String
  description     String            @db.Text
  displayOrder    Int               @default(0)
  featuredImage   String?
  visible         Boolean           @default(true)
  status          PublicationStatus @default(PUBLISHED)
  seoTitle        String?
  seoDescription  String?
  clinicalLocked  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  serviceAreas    ServiceOnArea[]

  @@index([category, displayOrder])
}

model ServiceArea {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?           @db.Text
  visible     Boolean           @default(true)
  services    ServiceOnArea[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ServiceOnArea {
  serviceId     String
  serviceAreaId String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([serviceId, serviceAreaId])
}

model PageContent {
  id        String            @id @default(uuid())
  key       String            @unique
  title     String
  body      Json
  status    PublicationStatus @default(DRAFT)
  updatedAt DateTime          @updatedAt
  createdAt DateTime          @default(now())
  revisions ContentRevision[]
}

model ContentRevision {
  id            String   @id @default(uuid())
  pageContentId String
  snapshot      Json
  createdById   String?
  createdAt     DateTime @default(now())

  pageContent PageContent @relation(fields: [pageContentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([pageContentId, createdAt])
}

model FAQ {
  id           String            @id @default(uuid())
  question     String
  answer       String            @db.Text
  displayOrder Int               @default(0)
  status       PublicationStatus @default(DRAFT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Testimonial {
  id              String            @id @default(uuid())
  quote           String            @db.Text
  authorName      String
  authorRole      String?
  permissionRecorded Boolean        @default(false)
  permissionNote  String?
  displayOrder    Int               @default(0)
  status          PublicationStatus @default(DRAFT)
  mediaAssetId    String?
  mediaAsset      MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  testimonials Testimonial[]
}

model JobPosting {
  id          String            @id @default(uuid())
  title       String
  slug        String            @unique
  description String            @db.Text
  location    String?
  status      PublicationStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id            String          @id @default(uuid())
  jobPostingId  String?
  fullName      String
  email         String
  phone         String?
  position      String
  message       String?         @db.Text
  resumeKey     String?
  status        ApplicantStatus @default(NEW)
  reviewerId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  reviewer   User?       @relation("ApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  sensitive Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String             @id @default(uuid())
  type        String
  payload     Json
  status      NotificationStatus @default(PENDING)
  attempts    Int                @default(0)
  lastError   String?            @db.Text
  leadId      String?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
}

model ConsentRecord {
  id        String   @id @default(uuid())
  leadId    String
  text      String   @db.Text
  version   String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}
